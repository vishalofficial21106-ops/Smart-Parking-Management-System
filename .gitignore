# ========================================================
# Git Ignore Configuration - Smart Parking Management System
# ========================================================

# Dependencies
node_modules/
**/node_modules/

# Environment files & secrets (Strictly ignored; templates preserved)
.env
.env.*
!.env.example
!*.env.example
!**/.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Production build outputs
dist/
**/dist/
build/
**/build/
dist-ssr/

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & cache
.eslintcache
.cache/
tmp/
temp/
