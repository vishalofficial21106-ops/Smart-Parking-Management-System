# ========================================================
# Cloud-Based Smart Parking Management System - Environment Template
# ========================================================
# Copy this file to .env in the backend folder and fill in your values:
#   cp .env.example .env
# ========================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection URI (Atlas Cloud or Local MongoDB)
# For MongoDB Atlas (Recommended for cloud deployment):
#   MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxxx.mongodb.net/smart_parking_db?retryWrites=true&w=majority
# For Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/smart_parking_db
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_parking_db?retryWrites=true&w=majority

# JWT Secret Key for token signing & verification
# (Generate a strong, random secret string for production)
JWT_SECRET=your_jwt_secret_key_placeholder

# Secret Passkey required for initial web-based Admin registration
# (Must never be shared publicly; used to prevent unauthorized admin creation)
ADMIN_SECRET_KEY=your_admin_registration_passkey_placeholder

# Allowed Frontend Client URL for CORS in development (comma-separated if multiple)
CLIENT_URL=http://localhost:5173
